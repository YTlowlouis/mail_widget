# Copie ce fichier en .env (jamais commité). Les identifiants IMAP restent dans
# mcp_server/.env — le daemon les charge automatiquement depuis là, inutile de les dupliquer ici.

# Clé API Groq (gratuite, sans carte bancaire pour démarrer) :
# https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel, valeurs par défaut déjà raisonnables :
# MAIL_WIDGET_MODEL=openai/gpt-oss-20b
# MAIL_WIDGET_POLL_SECONDS=180
# MAIL_WIDGET_POLL_LIMIT=30
# Pause (secondes) entre deux appels au modèle dans un même cycle, pour ne pas dépasser le
# rate limit du tier gratuit Groq lors d'un gros rattrapage initial:
# MAIL_WIDGET_THREAD_DELAY_SECONDS=2
# MAIL_MCP_COMMAND=mail-mcp
# Si mcp_server et daemon utilisent des venvs séparés, mets le chemin absolu de mail-mcp
# dans le venv du mcp_server, sinon "mail-mcp" ne sera pas trouvé dans le PATH du daemon:
# MAIL_MCP_COMMAND=/chemin/vers/mail_widget/mcp_server/.venv/bin/mail-mcp
# MAIL_WIDGET_ARCHIVE_FOLDER=[Gmail]/All Mail
# MAIL_WIDGET_CACHE_DIR=/home/toi/.cache/mail-widget
