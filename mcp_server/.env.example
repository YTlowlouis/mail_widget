# Copie ce fichier en .env (jamais commité) et remplis tes propres valeurs.
# Gmail: imap.gmail.com:993, avec un mot de passe d'application
# (nécessite la validation en 2 étapes activée sur le compte) :
# https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=ton.adresse@gmail.com
IMAP_PASSWORD=mot-de-passe-application-16-caracteres

# Dossier surveillé par défaut (list_recent, search_emails, move_to_trash source)
MAIL_MCP_DEFAULT_FOLDER=INBOX

# Où le serveur mémorise le dossier d'origine des mails mis à la corbeille
# (nécessaire pour restore). Par défaut: ~/.local/state/mail-mcp/trash_state.json
# MAIL_MCP_STATE_DIR=/home/toi/.local/state/mail-mcp
